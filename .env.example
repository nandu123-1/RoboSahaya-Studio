# Gnani AI API Credentials
# STT uses the X-API-Key-ID credential. TTS uses the configured Authorization scheme.
GNANI_API_KEY=
GNANI_STT_API_KEY_ID=
GNANI_TTS_API_KEY=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.gnani.ai/v1/tts/inference
GNANI_TTS_AUTH_SCHEME=Bearer

# Optional OpenAI-compatible reasoning service. Leave unset to use deterministic rules.
EVON_API_URL=
EVON_API_KEY=
EVON_MODEL_ID=evon

# ROS 2 Environment
ROS_DOMAIN_ID=0
ROBOSAHAYA_MODE=mock  # Set to 'live' for real ROS 2 graph introspection, 'mock' for fixture replay
ROBOSAHAYA_MOCK_SCENARIO=missing_laser_pub  # Default scenario for mock mode: missing_laser_pub, qos_reliability_mismatch, tf_broken_camera_link, sim_time_divergence, clean_healthy_system

# UI Server
HOST=127.0.0.1
PORT=7860
