# Gnani AI API Credentials
# Obtain API key from https://app.gnani.ai/voice
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL=https://api.gnani.ai/v1

# ROS 2 Environment
ROS_DOMAIN_ID=0
ROBOSAHAYA_MODE=mock  # Set to 'live' for real ROS 2 graph introspection, 'mock' for fixture replay
ROBOSAHAYA_MOCK_SCENARIO=missing_laser_pub  # Default scenario for mock mode: missing_laser_pub, qos_reliability_mismatch, tf_broken_camera_link, sim_time_divergence, clean_healthy_system

# UI Server
HOST=127.0.0.1
PORT=7860
